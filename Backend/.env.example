# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/stylemate
# OR use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stylemate?retryWrites=true&w=majority

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=7d

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI API (for AI recommendations - optional)
OPENAI_API_KEY=your_openai_api_key

# Hugging Face API (for SDXL image generation)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Local Python SDXL server (primary image generation)
LOCAL_AI_URL=http://127.0.0.1:8000/generate

# Weather API (optional)
WEATHER_API_KEY=your_weather_api_key

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Pexels API Key
PEXELS_API_KEY=your_pexels_api_key
